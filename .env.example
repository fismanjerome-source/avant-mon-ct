# Base de données (libSQL / Turso). En local, laissez vide pour utiliser
# un fichier SQLite local (local.db). En production, renseignez les deux :
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare Web Analytics (gratuit, sans cookie, sans bannière de consentement
# nécessaire). Créez un site en "Manual Setup" sur
# https://dash.cloudflare.com/?to=/:account/analytics/web puis collez le
# "token" fourni ici. Laissez vide pour désactiver (aucun script chargé).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Clé partagée avec Créneau CT : chaque page vue ici est reportée à
# https://creneauct.fr/api/interne/tracer pour apparaître dans son tableau
# de bord de statistiques (même valeur EXACTE que TRACER_SECRET côté
# Créneau CT — sans elle, aucun envoi n'a lieu, la navigation n'est jamais
# bloquée).
TRACER_SECRET=
